# Smart Rename AI provider
# Copy this file to Herdr's private plugin config, then add your key.
#
# Use ONE provider block at a time. Active SMART_RENAME_BASE_URL / MODEL /
# REASONING_EFFORT override registered profile defaults, so leave those
# commented when you switch providers (or set them to that provider's values).

OPENAI_API_KEY=

SMART_RENAME_PROVIDER=openai
SMART_RENAME_BASE_URL=https://api.openai.com/v1
SMART_RENAME_MODEL=gpt-5.6-luna
# none, low, medium, or high. none turns reasoning off, e.g. for local Ollama
# models that think by default; empty leaves the field out (provider default).
SMART_RENAME_REASONING_EFFORT=medium
SMART_RENAME_TIMEOUT_MS=45000

# Optional generic key for another OpenAI-compatible provider:
# SMART_RENAME_API_KEY=

# DeepSeek — comment out SMART_RENAME_BASE_URL / MODEL / REASONING_EFFORT above
# (or set the DeepSeek values below) so OpenAI overrides do not stay active:
# SMART_RENAME_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# SMART_RENAME_BASE_URL=https://api.deepseek.com
# SMART_RENAME_MODEL=deepseek-flash
# SMART_RENAME_REASONING_EFFORT=

# Optional custom prompt. Relative paths resolve from the plugin config directory:
# SMART_RENAME_PROMPT_PATH=naming-prompt.md
